# =========================================================
# CAREERFLOWOPS
# =========================================================

APP_ENV=development

# ---------------------------------------------------------
# API / FRONTEND
# ---------------------------------------------------------

API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=5173

VITE_API_BASE_URL=http://localhost:8000

CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------
# DATABASE
# ---------------------------------------------------------

POSTGRES_DB=careerflowops
POSTGRES_USER=careerflow
POSTGRES_PASSWORD=CHANGE_ME

DATABASE_URL=postgresql+psycopg://careerflow:CHANGE_ME@postgres:5432/careerflowops

# ---------------------------------------------------------
# MLFLOW
# ---------------------------------------------------------

MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_MODEL_NAME=careerflowops-ranker
MLFLOW_MODEL_ALIAS=production

# ---------------------------------------------------------
# DVC
# ---------------------------------------------------------

DVC_REMOTE_NAME=storage

# Local demo initially.
DVC_REMOTE_URL=./dvc-storage

# ---------------------------------------------------------
# ML
# ---------------------------------------------------------

SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2

MATCH_SEMANTIC_WEIGHT=0.40
MATCH_SKILL_WEIGHT=0.30
MATCH_ELIGIBILITY_WEIGHT=0.15
MATCH_LOCATION_WEIGHT=0.08
MATCH_FRESHNESS_WEIGHT=0.07

# ---------------------------------------------------------
# INGESTION
# ---------------------------------------------------------

INGEST_GREENHOUSE=true
INGEST_LEVER=true
INGEST_ASHBY=true
INGEST_WORKDAY=false
INGEST_JOBSPY=false

# ---------------------------------------------------------
# OPTIONAL HUGGING FACE
# ---------------------------------------------------------

HF_TOKEN=

# ---------------------------------------------------------
# AWS - DO NOT COMMIT REAL VALUES
# ---------------------------------------------------------

AWS_REGION=ap-south-1
AWS_ECR_REPOSITORY=careerflowops-api
AWS_EC2_HOST=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------
# MONITORING
# ---------------------------------------------------------

PROMETHEUS_ENABLED=true
LOG_LEVEL=INFO

# Generate distinct local tokens; candidate APIs and admin/TPO APIs require them.
CANDIDATE_API_TOKEN=
ADMIN_API_TOKEN=
RANKING_ALGORITHM=hybrid
USE_MODEL_REGISTRY=true
# Optional verified DVC release; when set, failures return 503 without local fallback.
# MODEL_BUNDLE_PATH=ml/artifacts/production
GRAFANA_ADMIN_PASSWORD=
