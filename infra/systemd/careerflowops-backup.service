[Unit]
Description=CareerFlowOps maintenance backup (brief application downtime)

[Service]
Type=oneshot
WorkingDirectory=%h/CareerFlowOps
Environment=DOCKER_HOST=unix:///var/run/docker.sock
ExecStart=%h/CareerFlowOps/.venv-deploy/bin/python -m infra.scripts.operations backup
TimeoutStartSec=30min
TimeoutStopSec=5min
KillMode=mixed
UMask=0077
