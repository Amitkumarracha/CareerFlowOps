{$PUBLIC_DOMAIN} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
    @backend path /api/* /health /ready /docs /openapi.json
    handle @backend {
        reverse_proxy api:8000
    }
    handle {
        reverse_proxy web:80
    }
}
